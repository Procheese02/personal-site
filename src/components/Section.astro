---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  body?: string;
}

const { id, eyebrow, title, body } = Astro.props;
---

<section id={id} class="reveal-section mx-auto w-full max-w-6xl px-6 py-14 sm:py-18">
  <div class="mb-8 max-w-3xl">
    {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-[0.28em] text-cyan">{eyebrow}</p>}
    <h2 class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">{title}</h2>
    {body && <p class="mt-4 text-lg leading-8 text-slate-300">{body}</p>}
  </div>
  <slot />
</section>
