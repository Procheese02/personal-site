---
import type { Project } from '../content/projects';
import type { Locale } from '../content/i18n';
import { copy } from '../content/i18n';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = copy[locale];
const summary = locale === 'zh' ? project.summaryZh : project.summary;
const category = locale === 'zh' ? project.categoryZh : project.category;
const highlights = locale === 'zh' ? project.highlightsZh : project.highlights;
---

<article class:list={['group rounded-[1.75rem] border bg-panel/70 p-6 shadow-xl shadow-black/20 backdrop-blur transition hover:-translate-y-1 hover:border-cyan/50', project.featured ? 'border-cyan/35 lg:col-span-2' : 'border-line']}>
  <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
    <div>
      {project.featured && <p class="mb-2 text-xs font-semibold uppercase tracking-[0.24em] text-cyan">{t.featured}</p>}
      <h3 class="text-2xl font-semibold text-white">{project.name}</h3>
      <p class="mt-2 text-sm text-slate-400">{category} · {project.period}</p>
    </div>
  </div>
  <p class="text-base leading-7 text-slate-300">{summary}</p>
  <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-300">
    {highlights.map((item) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-cyan"></span><span>{item}</span></li>)}
  </ul>
  <div class="mt-6 flex flex-wrap gap-2">
    {project.tech.map((tech) => <span class="rounded-full border border-line bg-white/[0.04] px-3 py-1 text-xs text-slate-300">{tech}</span>)}
  </div>
</article>
