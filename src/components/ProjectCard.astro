---
import type { Project } from '../content/projects';
import type { Locale } from '../content/i18n';
import { copy } from '../content/i18n';
import AnimatedProjectCard from './AnimatedProjectCard';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = copy[locale];
const summary = locale === 'zh' ? project.summaryZh : project.summary;
const category = locale === 'zh' ? project.categoryZh : project.category;
const highlights = locale === 'zh' ? project.highlightsZh : project.highlights;
---

<AnimatedProjectCard
  client:visible
  name={project.name}
  period={project.period}
  category={category}
  summary={summary}
  highlights={highlights}
  tech={project.tech}
  githubUrl={project.githubUrl}
  featured={project.featured}
  featuredLabel={t.featured}
  githubLabel={t.viewOnGithub}
/>
