---
import type { Locale } from '../content/i18n';
import { copy } from '../content/i18n';
import { profile } from '../content/profile';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const email = profile.email[locale];
---

<header class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-6">
  <a href={t.path} class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-300">JQ</a>
  <nav class="hidden items-center gap-6 text-sm text-slate-300 md:flex">
    {t.nav.map((item, index) => {
      const ids = ['about', 'education', 'skills', 'projects', 'contact'];
      return <a class="transition hover:text-white" href={`#${ids[index]}`}>{item}</a>;
    })}
  </nav>
  <div class="flex items-center gap-2">
    <ThemeToggle />
    <LanguageSwitch href={t.alternatePath} label={t.alternateLabel} />
  </div>
</header>

<section class="mx-auto grid min-h-[72vh] w-full max-w-6xl items-center gap-12 px-6 py-12 lg:grid-cols-[1.1fr_0.9fr]">
  <div>
    <h1 class="font-display text-5xl font-semibold leading-tight tracking-tight text-white sm:text-6xl lg:text-7xl">
      {profile.name}
      <span class="block bg-gradient-to-r from-cyan via-sky-200 to-violet bg-clip-text text-transparent">{t.heroTitle}</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">{t.heroBody}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#contact" class="rounded-full bg-cyan px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-200">{t.contactCta}</a>
      <a href="#projects" class="rounded-full border border-line bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:border-violet/60 hover:bg-violet/10">{t.projectsCta}</a>
    </div>
  </div>
  <div class="rounded-[2rem] border border-line bg-panel/75 p-6 shadow-2xl shadow-black/30 backdrop-blur">
    <div class="mb-6 flex items-center gap-4">
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-cyan to-violet text-2xl font-bold text-slate-950">JQ</div>
      <div>
        <p class="font-semibold text-white">{profile.location}</p>
        <p class="text-sm text-slate-400">{email}</p>
      </div>
    </div>
    <div class="space-y-3">
      {profile.roles.map((role) => <div class="rounded-2xl border border-line bg-white/[0.03] px-4 py-3 text-slate-200">{role}</div>)}
    </div>
    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      <div class="rounded-2xl border border-cyan/20 bg-cyan/10 p-4">
        <p class="text-2xl font-semibold text-white">4+</p>
        <p class="mt-1 text-sm text-slate-300">{t.statProjects}</p>
      </div>
      <div class="rounded-2xl border border-line bg-white/[0.03] p-4">
        <p class="text-2xl font-semibold text-white">2026</p>
        <p class="mt-1 text-sm text-slate-300">{t.statMeng}</p>
      </div>
      <div class="rounded-2xl border border-violet/20 bg-violet/10 p-4">
        <p class="text-2xl font-semibold text-white">AWS</p>
        <p class="mt-1 text-sm text-slate-300">{t.statCloud}</p>
      </div>
    </div>
  </div>
</section>
