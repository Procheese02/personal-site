---
import type { Locale } from '../content/i18n';
import { copy } from '../content/i18n';
import { profile } from '../content/profile';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import Aurora from './Aurora';
import InteractiveHeroStage from './InteractiveHeroStage';
import MagneticButton from './MagneticButton';
import SplitText from './SplitText';
import TextType from './TextType';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const email = profile.email[locale];
const name = profile.name[locale];
const typewriterRoles = profile.roles[locale];
const heroStats = [
  { value: 4, suffix: '+', label: t.statProjects, tone: 'cyan' },
  { value: 2026, label: t.statMeng, tone: 'slate' },
] as const;
---

<header class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-6">
  <a href={t.path} class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-300">JQ</a>
  <nav class="hidden items-center gap-6 text-sm text-slate-300 md:flex">
    {t.nav.map((item, index) => {
      const ids = ['about', 'education', 'skills', 'projects', 'contact'];
      return <a class="top-nav-link transition hover:text-white" href={`#${ids[index]}`}>{item}</a>;
    })}
  </nav>
  <div class="flex items-center gap-2">
    <ThemeToggle />
    <LanguageSwitch href={t.alternatePath} label={t.alternateLabel} />
  </div>
</header>

<section class="relative mx-auto grid min-h-[72vh] w-full max-w-6xl items-center gap-12 overflow-hidden px-6 py-12 lg:grid-cols-[1.1fr_0.9fr]">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[28rem] opacity-70">
    <Aurora client:load colorStops={["#22d3ee", "#a78bfa", "#38bdf8"]} amplitude={0.8} blend={0.65} speed={0.7} />
  </div>
  <div>
    <h1 class="font-display text-5xl font-semibold leading-tight tracking-tight text-white sm:text-6xl lg:text-7xl">
      <SplitText client:load text={name} className="block" />
      <span class="block bg-gradient-to-r from-cyan via-sky-200 to-violet bg-clip-text text-transparent">{t.heroTitle}</span>
    </h1>
    <TextType
      client:load
      text={typewriterRoles}
      as="p"
      className="mt-5 min-h-[2rem] font-mono text-xl text-cyan sm:text-2xl"
      typingSpeed={85}
      deletingSpeed={40}
      pauseDuration={1200}
      cursorClassName="text-sky-200"
    />
    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">{t.heroBody}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <MagneticButton client:load href="#contact" label={t.contactCta} variant="primary" />
      <MagneticButton client:load href="#projects" label={t.projectsCta} variant="secondary" />
    </div>
  </div>
  <InteractiveHeroStage client:load location={profile.location} email={email} stats={heroStats} />
</section>
