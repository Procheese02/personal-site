---
import { profile } from '../content/profile';
import type { Locale } from '../content/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2">
  {profile.education.map((item) => (
    <div class="rounded-[1.5rem] border border-line bg-panel/70 p-6 backdrop-blur">
      <p class="text-sm font-medium text-cyan">{item.period}</p>
      <h3 class="mt-3 text-xl font-semibold text-white">{item.school}</h3>
      <p class="mt-2 leading-7 text-slate-300">{locale === 'zh' ? item.degreeZh : item.degree}</p>
      <p class="mt-2 text-sm text-slate-500">{item.location}</p>
    </div>
  ))}
</div>
