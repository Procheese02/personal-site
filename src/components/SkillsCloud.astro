---
import { profile } from '../content/profile';
import type { Locale } from '../content/i18n';
import MagneticSkills from './MagneticSkills';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const labels = locale === 'zh'
  ? { languages: '编程语言', frameworks: '框架', cloudDevOps: '云与 DevOps', aiData: 'AI 与数据' }
  : { languages: 'Languages', frameworks: 'Frameworks', cloudDevOps: 'Cloud & DevOps', aiData: 'AI & Data' };
const groups = Object.entries(profile.skills).map(([key, values]) => ({
  label: labels[key as keyof typeof labels],
  values: [...values],
}));
---

<MagneticSkills client:visible groups={groups} />
