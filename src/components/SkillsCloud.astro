---
import { profile } from '../content/profile';
import type { Locale } from '../content/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const labels = locale === 'zh'
  ? { languages: '编程语言', frameworks: '框架', cloudDevOps: '云与 DevOps', aiData: 'AI 与数据' }
  : { languages: 'Languages', frameworks: 'Frameworks', cloudDevOps: 'Cloud & DevOps', aiData: 'AI & Data' };
---

<div class="grid gap-4 md:grid-cols-2">
  {Object.entries(profile.skills).map(([key, values]) => (
    <div class="rounded-[1.5rem] border border-line bg-panel/70 p-6 backdrop-blur">
      <h3 class="mb-4 text-lg font-semibold text-white">{labels[key as keyof typeof labels]}</h3>
      <div class="flex flex-wrap gap-2">
        {values.map((skill) => <span class="rounded-full border border-line bg-white/[0.04] px-3 py-1.5 text-sm text-slate-300">{skill}</span>)}
      </div>
    </div>
  ))}
</div>
